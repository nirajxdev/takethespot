generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String?
  email             String             @unique
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  products          Product[]
  purchases         Purchase[]
  activities        Activity[]
  reservations      Reservation[]
  cellReservations  CellReservation[]
  ownedCells        Cell[]             @relation("CellOwner")
}

model Product {
  id          String     @id @default(cuid())
  userId      String
  name        String
  slug        String     @unique
  description String?
  websiteUrl  String?
  logoUrl     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  territories Territory[]
  purchases   Purchase[]
  activities  Activity[]
  cells       Cell[]

  @@index([userId])
}

/// Legacy rectangle territories — kept for migration; new ownership uses Cell.
model Territory {
  id           String          @id @default(cuid())
  productId    String
  x            Int
  y            Int
  width        Int
  height       Int
  currentPrice Int
  initialPrice Int
  status       TerritoryStatus @default(AVAILABLE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchases    Purchase[]
  activities   Activity[]

  @@index([productId])
  @@index([status])
}

/// Individual board cell ownership (sparse — only non-available cells stored).
model Cell {
  x                   Int
  y                   Int
  productId           String?
  ownerId             String?
  currentValueInCents Int         @default(10)
  status              CellStatus  @default(AVAILABLE)
  updatedAt           DateTime    @updatedAt
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner               User?       @relation("CellOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@id([x, y])
  @@index([productId])
  @@index([ownerId])
  @@index([status])
}

model Purchase {
  id          String         @id @default(cuid())
  userId      String
  productId   String
  territoryId String?
  amount      Int
  type        PurchaseType
  status      PurchaseStatus @default(PENDING)
  paymentId   String?
  currency    String         @default("USD")
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  territory   Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  cells       PurchaseCell[]

  @@index([userId])
  @@index([productId])
  @@index([territoryId])
}

model PurchaseCell {
  id                    String   @id @default(cuid())
  purchaseId            String
  cellX                 Int
  cellY                 Int
  previousOwnerId       String?
  previousProductId     String?
  previousValueInCents  Int?
  purchasePriceInCents  Int
  newValueInCents       Int
  createdAt             DateTime @default(now())
  purchase              Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([cellX, cellY])
}

/// Groups reserved cells during checkout (10-minute expiry).
model CellReservation {
  id            String   @id @default(cuid())
  reservationId String
  userId        String
  cellX         Int
  cellY         Int
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([userId])
  @@index([expiresAt])
  @@index([cellX, cellY])
}

model Activity {
  id          String       @id @default(cuid())
  userId      String?
  productId   String?
  territoryId String?
  type        ActivityType
  metadata    Json?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  territory   Territory?   @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

/// Legacy rectangle reservation — superseded by CellReservation.
model Reservation {
  id        String   @id @default(cuid())
  userId    String
  x         Int
  y         Int
  width     Int
  height    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum CellStatus {
  AVAILABLE
  OWNED
  RESERVED
}

enum TerritoryStatus {
  AVAILABLE
  OWNED
  RESERVED
}

enum PurchaseType {
  INITIAL_PURCHASE
  MIXED_PURCHASE
  TAKEOVER
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ActivityType {
  PRODUCT_CREATED
  TERRITORY_CLAIMED
  TERRITORY_TAKEN_OVER
  CELLS_PURCHASED
  CELLS_TAKEN_OVER
  RESERVATION_CREATED
  RESERVATION_EXPIRED
}

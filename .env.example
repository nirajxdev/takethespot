# =============================================================================
# DATABASE — Neon PostgreSQL (recommended)
# =============================================================================
# 1. Sign up at https://neon.tech and create a project
# 2. In the Neon console: your project → Connect → Connection string
# 3. Select "postgresql://" (not prisma+postgres://)
# 4. Copy the string and paste it as DATABASE_URL below
#
# Neon example (replace with your own credentials):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Local Postgres alternative:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takethespot"

# =============================================================================
# CLERK AUTHENTICATION — REQUIRED
# =============================================================================
# The app will NOT start until these are set.
#
# 1. Create an application at https://dashboard.clerk.com
# 2. Go to Configure → API Keys
# 3. Copy both keys below:
#
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY — starts with pk_test_ (or pk_live_)
#   CLERK_SECRET_KEY                  — starts with sk_test_ (or sk_live_)
#
# Quick setup (writes keys to .env automatically):
#   npx clerk@latest init
# Or pull from an existing Clerk app:
#   npx clerk@latest env pull
#
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs (optional — defaults work for this project)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# File storage (Phase 2+)
# UPLOADTHING_SECRET=
# UPLOADTHING_APP_ID=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payments — Razorpay (Phase 5 — do not configure yet)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# PRODUCTION (Clerk + hosting)
# =============================================================================
# 1. Clerk Dashboard → Create production instance → Domains → add DNS records
# 2. Clerk Dashboard → Deploy certificates (after DNS propagates)
# 3. Pull live keys: npx clerk@latest env pull --instance prod
# 4. Set NEXT_PUBLIC_APP_URL to your production origin (no trailing slash)
# 5. Set the same env vars on your host (Vercel, etc.) and redeploy
#
# Production Clerk keys use pk_live_ / sk_live_ prefixes (not pk_test_ / sk_test_).
# If you use social sign-in, add your own OAuth credentials in the Clerk Dashboard.
#
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...

# Local `npm run dev` writes plots/config/transactions/checkouts to JSON files.
# Do not set VERCEL locally; that flag is injected on Vercel and switches storage to Neon.

PORT=3000

# Required on Vercel (Project Settings → Environment Variables).
# Create a Neon database (https://console.neon.tech) and paste the pooled
# connection string (postgresql://... or postgres://...). Redeploy after saving.
DATABASE_URL=

# Dodo Payments (test mode first). Official names are DODO_PAYMENTS_*; aliases also work.
# Dashboard: https://app.dodopayments.com/  Docs: https://docs.dodopayments.com
#
# 1. Developer → API → copy API key
# 2. Products → add a one-time product with Pay What You Want enabled
#    (minimum at or below your cheapest plot, usually $1.00). Copy product id (pdt_...).
# 3. Developer → Webhooks → URL:
#    Production: https://takethespot.lol/api/webhooks/dodo
#    Subscribe to payment.succeeded (also payment.failed / payment.cancelled).
#    Copy the webhook signing secret.
#
# Amounts are cents (lowest currency unit). Ownership is granted only after a
# verified webhook — never from the browser saying payment succeeded.

DODO_PAYMENTS_API_KEY=
# Alias: DODO_API_KEY=

DODO_PAYMENTS_WEBHOOK_KEY=
# Alias: DODO_WEBHOOK_SECRET=

DODO_PAYMENTS_ENVIRONMENT=test_mode
# Alias: DODO_ENVIRONMENT=test_mode | live_mode

DODO_PRODUCT_ID=

# Optional. Return URL base (no trailing slash). Defaults to the request host.
# Production example: https://takethespot.lol
APP_URL=

# Local-only: set to true to re-enable POST /api/purchase without Dodo (never on Vercel).
ALLOW_DIRECT_PURCHASE=false

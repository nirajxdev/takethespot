# Local `npm run dev` writes plots/config/transactions to JSON files.
# Do not set VERCEL locally; that flag is injected on Vercel and switches storage to Neon.

PORT=3000

# Required on Vercel (Settings → Environment Variables).
# Use the leftover Neon project or create a new one at https://console.neon.tech
# then paste the pooled connection string here / in the Vercel dashboard.
DATABASE_URL=
